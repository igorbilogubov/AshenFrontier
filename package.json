{
  "name": "ashen-frontier",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node scripts/start.mjs",
    "db:start": "node scripts/local-database.mjs start",
    "db:stop": "node scripts/local-database.mjs stop",
    "db:backup": "node scripts/database-backup.mjs",
    "art:preview": "npm run build && node scripts/serve-art-test.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "check": "npm run typecheck && node scripts/check.mjs",
    "stress": "npm run build && node scripts/stress.mjs",
    "stress:report": "node scripts/performance-report.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "^8.23.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "three": "0.186.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Shared browser 3D RPG"
}

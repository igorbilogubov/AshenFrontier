{
  "name": "ashen-frontier",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node server.mjs",
    "art:preview": "npm run build && node scripts/serve-art-test.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && node scripts/check.mjs",
    "godot:sync": "npm run build && node scripts/godot/sync-assets.mjs",
    "godot:import": "npm run godot:sync && node scripts/godot/tool.mjs import",
    "godot:run": "node scripts/godot/tool.mjs run",
    "godot:editor": "node scripts/godot/tool.mjs editor",
    "godot:export": "npm run godot:import && node scripts/godot/tool.mjs export",
    "godot:server": "npm run build && node scripts/godot/serve.mjs",
    "godot:test": "node scripts/godot/test.mjs",
    "godot:export:macos": "npm run godot:import && node scripts/godot/tool.mjs export-macos"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "three": "0.186.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Shared browser 3D RPG"
}
